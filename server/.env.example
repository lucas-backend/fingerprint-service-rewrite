# PostgreSQL connection used by the .NET fingerprint service.
# Use the hostname reachable from Docker, for example host.docker.internal
# when PostgreSQL is running on the Windows host.
POSTGRES_CONNECTION_STRING=Host=host.docker.internal;Port=5432;Database=limen_db;Username=limen_user;Password=<secret>;Timeout=5;Command Timeout=5;Maximum Pool Size=20

# Hostname used by the Express container to reach the same PostgreSQL instance.
# Use host.docker.internal for PostgreSQL running on the Docker host.
DB_HOST=host.docker.internal
