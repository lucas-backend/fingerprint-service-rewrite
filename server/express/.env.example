# Server (Express) configuration
#
# Copy to `.env` and fill in real values. Never commit `.env`.

# HTTP port
PORT=3000

# limen_db connection (single unified database, owned by server)
DB_HOST=localhost
DB_PORT=5432
DB_USER=limen_user
DB_PASSWORD=
DB_NAME=limen_db

# Fingerprint service base URL (HTTP contract, not a database)
# In compose this is overridden to http://fingerprint-service:8080.
# For a standalone host/container, use the published host URL.
FINGERPRINT_SERVICE_URL=http://localhost:5001
